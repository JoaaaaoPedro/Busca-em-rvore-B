/*
 * Le o nó que está na posição pt do arquivo de dados
 */
TNo *le_no_pos(FILE *arq, int d, int pt) {
    fseek(arq, pt, SEEK_SET);
    return le_no(d, arq);
}

/*
 * Busca binária da posição em que a chave deveria estar dentro do nó.
 */
int posicao(int chave, TNo *no) {
    int inicio = 0;
    int fim = no->m;
    int pos = (fim + inicio) / 2;
    while (pos != no->m && chave != no->clientes[pos]->cod_cliente && inicio < fim) {
        if (chave > no->clientes[pos]->cod_cliente) {
            inicio = pos + 1;
        } else {
            fim = pos;
        }
        pos = (fim + inicio) / 2;
    }
    return pos;
}

/*
 * Busca a chave na subárvore cuja raiz está gravada na posição ptNo do arquivo de dados
 * d é a ordem da árvore
 * Retorna uma cópia do cliente encontrado (criada com a função cliente), ou NULL caso a chave não exista
 * Grava em *pt_no a posição (no arquivo de dados) do nó onde a chave foi encontrada, ou -1 caso ela não exista
 * Incrementa *qtd_nos_lidos uma vez para cada nó lido do arquivo de dados
 * (cada nó deve ser lido no máximo uma vez)
 */
TCliente *busca_no(FILE *arq, int d, int ptNo, int chave, int *pt_no, int *qtd_nos_lidos) {
    // Caso base: ponteiro nulo (chegou em folha sem encontrar a chave)
    if (ptNo == -1) {
        *pt_no = -1;
        return NULL;
    }

    // Lê o nó atual do arquivo de dados
    TNo *no = le_no_pos(arq, d, ptNo);
    if (no == NULL) {
        *pt_no = -1;
        return NULL;
    }

    // Incrementa a quantidade de nós lidos
    (*qtd_nos_lidos)++;

    // Descobre a posição da chave dentro do nó (busca binária)
    int pos = posicao(chave, no);

    // Verifica se a chave está no nó atual
    if (pos < no->m && no->clientes[pos]->cod_cliente == chave) {
        *pt_no = ptNo;

        // Cria uma cópia do cliente usando a função 'cliente'
        TCliente *cli_encontrado = cliente(no->clientes[pos]->cod_cliente,
                                            no->clientes[pos]->nome);

        // Libera a memória do nó lido
        libera_no(d, no);

        return cli_encontrado;
    } else {
        // A chave não está neste nó. Desce para o filho apropriado.
        int prox_pt = no->p[pos];

        // Libera a memória do nó atual antes de descer
        libera_no(d, no);

        // Chamada recursiva
        return busca_no(arq, d, prox_pt, chave, pt_no, qtd_nos_lidos);
    }
}

/*
 * Busca o cliente de código chave na árvore B armazenada em disco
 * d é a ordem da árvore
 * Retorna uma cópia do cliente encontrado (criada com a função cliente), ou NULL caso a chave não exista
 * Grava em *pt_no a posição (no arquivo de dados) do nó onde a chave foi encontrada, ou -1 caso ela não exista
 * Grava em *qtd_nos_lidos a quantidade de nós lidos do arquivo de dados durante a busca
 * Uma árvore vazia (pont_raiz igual a -1) não tem nós para ler
 */
TCliente *busca(int chave, char *nome_arquivo_metadados, char *nome_arquivo_dados, int d, int *pt_no, int *qtd_nos_lidos) {
    *pt_no = -1;
    *qtd_nos_lidos = 0;

    // Lê os metadados
    TMetadados *meta = le_arq_metadados(nome_arquivo_metadados);
    if (meta == NULL) {
        return NULL;
    }

    int pont_raiz = meta->pont_raiz;
    free(meta);

    // Árvore vazia: nenhum nó para ler
    if (pont_raiz == -1) {
        return NULL;
    }

    // Abre o arquivo de dados
    FILE *arq_dados = fopen(nome_arquivo_dados, "rb");
    if (arq_dados == NULL) {
        return NULL;
    }

    // Chama a busca recursiva a partir da raiz
    TCliente *cli = busca_no(arq_dados, d, pont_raiz, chave, pt_no, qtd_nos_lidos);

    fclose(arq_dados);
    return cli;
}

